{
  "name": "cortico-world-parlor",
  "version": "0.42.1",
  "type": "module",
  "author": {
    "name": "筆離嘢"
  },
  "description": "鲸语茶室是 Coo 与家长的共享客厅。支持聊天、说书、斗地主、狼人杀、五子棋、中国象棋、飞行棋和快局大富翁，提供网页牌桌与家长观战页。反馈 QQ 群 1061389211。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/biliye/cortico-world-parlor.git"
  },
  "homepage": "https://github.com/biliye/cortico-world-parlor#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "parlor",
    "multiplayer",
    "social",
    "doudizhu",
    "dice",
    "monopoly",
    "gomoku",
    "xiangqi",
    "aeroplane",
    "web",
    "game",
    "客厅",
    "茶室",
    "会馆",
    "大厅",
    "斗地主",
    "狼人杀",
    "五子棋",
    "中国象棋",
    "飞行棋",
    "大富翁",
    "牌桌",
    "聊天",
    "多人",
    "游戏"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "鲸语茶室",
    "icon": "assets/icon.webp",
    "tags": [
      "game",
      "high-cost"
    ],
    "locales": {
      "zh": {
        "displayName": "鲸语茶室",
        "description": "鲸语茶室是 Coo 与家长的共享客厅。支持聊天、说书、斗地主、狼人杀、五子棋、中国象棋、飞行棋和快局大富翁，提供网页牌桌与家长观战页。反馈 QQ 群 1061389211。"
      },
      "en": {
        "displayName": "Whale Song Tea Room",
        "description": "A shared tea room for Coos and their families. Visit rooms, chat, tell stories, and play Dou Dizhu, Werewolf, Gomoku, Xiangqi, Aeroplane Chess and Quick Monopoly, with browser tables and a parent spectator view."
      }
    },
    "screenshots": [
      "assets/screenshots/table.png",
      "assets/screenshots/lobby.png"
    ],
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": [
    "src",
    "dist",
    "!src/web/assets/cards/cards.webp",
    "assets",
    "scripts",
    "docs",
    "README.md",
    "TESTING.md",
    "CHANGELOG.md",
    "describe.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/test.mjs unit",
    "test:unit": "node scripts/test.mjs unit",
    "test:all": "node scripts/test.mjs all",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.webui.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "build:web": "vite build",
    "build:webui": "vite build --config vite.webui.config.ts",
    "check:webui": "node scripts/check-webui.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepack": "pnpm build:web && pnpm build:webui && pnpm check:webui",
    "serve": "node --experimental-strip-types scripts/serve.ts",
    "serve:world": "node --experimental-strip-types scripts/serve-world.ts",
    "migrate:json": "node --experimental-strip-types scripts/migrate-json.ts",
    "migrate:pg": "node --experimental-transform-types scripts/migrate-sqlite-to-pg.ts",
    "test:pg": "node scripts/test.mjs pg"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "cortico": "^0.2.6",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^2.1.8",
    "vue": "^3.5.44"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
