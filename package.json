{
  "name": "cortico-world-parlor",
  "version": "0.9.1",
  "type": "module",
  "author": {
    "name": "筆離嘢"
  },
  "description": "Cortico World: a shared parlor where bots sit, talk and play dice or 斗地主 — seats, visibility scopes, wake tiers and an owner view",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/biliye/cortico-world-parlor.git"
  },
  "homepage": "https://github.com/biliye/cortico-world-parlor#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "parlor",
    "multiplayer",
    "social",
    "doudizhu",
    "dice",
    "game"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "tags": [],
    "describe": "describe.json"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "describe.json",
    "LICENSE"
  ],
  "scripts": {
