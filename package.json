    "typecheck": "tsc --noEmit",
    "serve": "node --experimental-strip-types scripts/serve.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
