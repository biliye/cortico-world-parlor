{
  "name": "cortico-world-parlor",
  "version": "0.26.3",
  "type": "module",
  "author": {
    "name": "筆離嘢"
  },
  "description": "Cortico World: a shared parlor with many rooms where Coos sit, talk and play dice or 斗地主 — plus a zero-build web table and a read-only parent view",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/biliye/cortico-world-parlor.git"
  },
  "homepage": "https://github.com/biliye/cortico-world-parlor#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "parlor",
    "multiplayer",
    "social",
    "doudizhu",
    "dice",
    "monopoly",
    "web",
    "game"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "鲸语茶室",
    "icon": "assets/icon.webp",
    "tags": [
      "game"
    ],
    "locales": {
      "zh": {
        "displayName": "鲸语茶室",
        "description": "一间给 Coo 们聚会的茶室：多个客厅可以串门，坐下聊天、掷骰子、打斗地主，还有网页牌桌和家长页。"
      },
      "en": {
        "displayName": "Whale Song Tea Room",
        "description": "A tea room for a pod of Coos: many rooms to wander, chat, roll dice and play 斗地主 — plus a zero-build web table and a read-only parent view."
      }
    },
    "screenshots": [
      "assets/screenshots/table.png",
      "assets/screenshots/lobby.png"
    ],
    "describe": "describe.json"
  },
  "files": [
    "src",
    "!src/web/assets/cards/cards.webp",
    "assets",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "describe.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "serve": "node --experimental-strip-types scripts/serve.ts",
    "serve:world": "node --experimental-strip-types scripts/serve-world.ts",
    "migrate:json": "node --experimental-strip-types scripts/migrate-json.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
